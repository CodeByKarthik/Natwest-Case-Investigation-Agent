{
  "realm": "natwest",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "NatWest Case Investigation",
  "roles": {
    "realm": [
      {
        "name": "customer_support",
        "description": "Handles initial customer contact and routine queries. Read-only access to support-visible cases. Cannot see internal notes or fraud cases."
      },
      {
        "name": "fraud_investigator",
        "description": "Investigates disputed transactions and suspected scams. Can update status on fraud and dispute cases. Cannot manage next actions or modify compliance records."
      },
      {
        "name": "compliance_officer",
        "description": "Oversees case quality, vulnerability handling, and regulatory reporting. Full access to all cases, events, and write operations."
      }
    ]
  },
  "clients": [
    {
      "clientId": "natwest-agent-api",
      "name": "NatWest Agent API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*",
        "http://localhost:8501/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:3000",
        "http://localhost:8501"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-subject-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "sub",
            "id.token.claim": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer_support",
      "enabled": true,
      "email": "customer_support@natwest.local",
      "firstName": "Customer",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "support_pass123",
          "temporary": false
        }
      ],
      "realmRoles": ["customer_support"]
    },
    {
      "username": "fraud_investigator",
      "enabled": true,
      "email": "fraud_investigator@natwest.local",
      "firstName": "Fraud",
      "lastName": "Investigator",
      "credentials": [
        {
          "type": "password",
          "value": "investigator_pass123",
          "temporary": false
        }
      ],
      "realmRoles": ["fraud_investigator"]
    },
    {
      "username": "compliance_officer",
      "enabled": true,
      "email": "compliance_officer@natwest.local",
      "firstName": "Compliance",
      "lastName": "Officer",
      "credentials": [
        {
          "type": "password",
          "value": "officer_pass123",
          "temporary": false
        }
      ],
      "realmRoles": ["compliance_officer"]
    }
  ]
}